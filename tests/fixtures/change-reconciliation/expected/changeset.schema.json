{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Makora changeset fixture schema example",
  "type": "object",
  "required": ["base_revision", "changes"],
  "properties": {
    "base_revision": {"type": "string"},
    "changes": {"type": "array", "items": {"type": "object", "required": ["id", "operation", "path", "reason"]}}
  }
}
